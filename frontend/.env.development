# 开发环境配置
VITE_API_BASE_URL=http://127.0.0.1:8000
# Phase 3B is opt-in; keep the legacy ChatQAPanel as the default baseline.
VITE_AI_VIZ_ENABLED=true
# Vite proxies /ai-service to the standalone AI Service at 127.0.0.1:8010.
VITE_AI_SERVICE_BASE_URL=/ai-service
# Phase 4B knowledge base is local-development only; requires backend AI_KB_LOCAL_DEV_ONLY=true
VITE_KB_ENABLED=true
